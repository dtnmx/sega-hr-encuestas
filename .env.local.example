# Copia este archivo a .env.local y rellena con las credenciales del proyecto.
# .env.local NO se sube a git. En Vercel se configuran en
# Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usar la PUBLISHABLE key (sb_publishable_...). En proyectos Supabase nuevos
# la anon key legacy (JWT, eyJ...) viene deshabilitada.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
